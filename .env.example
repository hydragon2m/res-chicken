# Copy this file to .env before starting Docker Compose.
# Keep browser-visible configuration in NEXT_PUBLIC_* variables only.
NODE_ENV=production
WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Set to the known number of trusted reverse-proxy hops in production.
# Leave unset in local Docker; never enable it blindly.
TRUST_PROXY=
POSTGRES_DB=chick_res
POSTGRES_USER=chick_res
POSTGRES_PASSWORD=change-me-for-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chick_res:change-me-for-local-only@localhost:5432/chick_res?schema=public
DATABASE_URL_DOCKER=postgresql://chick_res:change-me-for-local-only@postgres:5432/chick_res?schema=public
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Server-side only. Never prefix these with NEXT_PUBLIC_ or commit real values.
# Outbound: Chick Res calls VietQR to create a dynamic QR.
VIETQR_ENABLED=false
VIETQR_API_BASE_URL=https://dev.vietqr.org
VIETQR_API_USERNAME=
VIETQR_API_PASSWORD=
VIETQR_BANK_CODE=MB
VIETQR_BANK_ACCOUNT=
VIETQR_ACCOUNT_NAME=
# Inbound: VietQR calls token-generate with this Basic credential, then uses
# the returned Bearer token to call transaction-sync.
VIETQR_CALLBACK_USERNAME=
VIETQR_CALLBACK_PASSWORD=
VIETQR_CALLBACK_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
